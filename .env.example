# Copy this file to .env and replace every placeholder before deployment.
# Generate SECRET_KEY with:
# python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=replace-with-a-unique-random-secret-at-least-50-characters-long
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Compose uses PostgreSQL. For local SQLite development, set USE_POSTGRES=False
# and run Django directly instead of starting the Compose stack.
USE_POSTGRES=True
DB_NAME=eatzo
DB_USER=eatzo
DB_PASSWORD=replace-with-a-strong-database-password
DB_PORT=5432

# The Compose Nginx service expects a trusted HTTPS-terminating proxy in front
# of it. Enable these only when that proxy forwards X-Forwarded-Proto and direct
# public access to the Nginx origin is blocked.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUST_X_FORWARDED_PROTO=False

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-an-email-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

RAZORPAY_KEY_ID=replace-with-your-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret

MIN_ORDER_AMOUNT=0
MAX_CART_ITEMS=50
